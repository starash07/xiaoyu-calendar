{
  "name": "richeng-guajian",
  "productName": "小鱼日程表",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 桌面日程工具：桌面挂件、月历主界面与系统托盘",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "selftest:desktop": "electron . --selftest --desktop-host-smoke",
    "selftest:desktop-ui": "electron . --selftest --desktop-smoke",
    "selftest:desktop-headless": "electron . --selftest --desktop-headless",
    "selftest:desktop-motion": "electron scripts/check-desktop-motion.cjs --selftest",
    "selftest:calendar-selection": "electron scripts/check-calendar-selection.cjs --selftest",
    "selftest:task-dialog": "electron scripts/check-task-dialog.cjs --selftest",
    "selftest:settings": "electron scripts/check-settings.cjs --selftest",
    "selftest:panel-motion": "node scripts/check-panel-motion.cjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "electron": "^44.4.2"
  },
  "dependencies": {
    "koffi": "^2.16.3"
  }
}
